#include <stdio.h>
#include <stdlib.h>
#include <inttypes.h>

int main() {

	//静态内存定义
	int static_arr[5] = { 1, 2, 3, 4, 5 };

	//动态内存定义
	int* dynamic_arr = (int*)malloc(5 * sizeof(int));
	
	puts("静态数组内容:");
	for (size_t i = 0; i < 5; i++) {
		printf("%d ", static_arr[i]);
	}
	puts("");

	for (size_t i = 0; i < 5; i++) {
		dynamic_arr[i] = (i + 1) * 10;
	}
	
	puts("动态数组内容:");
	for (size_t i = 0; i < 5; i++) {
		printf("%d ", dynamic_arr[i]);
	}
	puts("");

	if (dynamic_arr == NULL) {
		perror("动态数组分配失败");
		exit(EXIT_FAILURE);
	}
	free(dynamic_arr);

	return 0;
}